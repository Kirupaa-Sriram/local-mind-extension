{
    "manifest_version": 3,
    "name": "Local Mind: AI Browsing Memory",
    "version": "1.0.0",
    "author": "Kirupaa Sri Ram",
    "description": "A private, local AI companion for your browsing history.",
    "action": {
        "default_title": "Access AI Browsing Memory",
        "default_icon": {
            "16": "icon16.png",
            "48": "icon48.png",
            "128": "icon128.png"
        }
    },
    "permissions": [
        "sidePanel",
        "storage",
        "activeTab",
        "offscreen",
        "alarms",
        "unlimitedStorage"
    ],
    "side_panel": {
        "default_path": "index.html"
    },
    "icons": {
        "16": "icon16.png",
        "48": "icon48.png",
        "128": "icon128.png"
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "exclude_matches": [
                "*://mail.google.com/*",
                "*://outlook.live.com/*",
                "*://outlook.office.com/*",
                "*://*.youtube.com/*",
                "*://youtube.com/*",
                "*://youtu.be/*",
                "*://*.google.com/search*",
                "*://google.com/search*",
                "*://*.google.co.uk/search*",
                "*://*.google.ca/search*",
                "*://*.google.de/search*",
                "*://*.google.in/search*",
                "*://*.bing.com/search*",
                "*://duckduckgo.com/*",
                "*://*.search.yahoo.com/*"
            ],
            "js": ["src/content/scraper.js"]
        }
    ],
    "background": {
        "service_worker": "src/background/background.js",
        "type": "module"
    },
    "content_security_policy": {
        "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
    }
}